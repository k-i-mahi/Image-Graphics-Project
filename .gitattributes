# Normalise line endings in the repository; Windows scripts keep CRLF
* text=auto
*.bat text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.pdf binary

# Vendored libraries are not counted in the GitHub language bar
include/glm/** linguist-vendored
include/stb_easy_font.h linguist-vendored
extern/** linguist-vendored
